{
    "name": "kakbima/kakbima",
    "type": "saas-platform",
    "description": "Insurance CRM software for agents, brokers, micro-insurers and insurers",
    "keywords": [
        "kakbima",
        "insurance",
        "crm",
        "intermediaries",
        "underwriters"
    ],
    "require": {
        "php": "^8.5",
        "authorizenet/authorizenet": "2.0.4",
        "aws/aws-sdk-php": "3.394.6",
        "cashfree/cashfree-pg": "6.0.5",
        "coingate/coingate-php": "v4.1.0",
        "fedapay/fedapay-php": "0.4.8",
        "google/apiclient": "v2.19.4",
        "inertiajs/inertia-laravel": "v3.3.2",
        "iyzico/iyzipay-php": "v2.0.61",
        "lab404/laravel-impersonate": "1.7.8",
        "larabug/larabug": "3.8.1",
        "laravel/framework": "v13.30.1",
        "laravel/tinker": "v3.0.2",
        "league/flysystem-aws-s3-v3": "3.35.3",
        "maatwebsite/excel": "4.0.2",
        "mercadopago/dx-php": "3.16.0",
        "milon/barcode": "v13.1",
        "mollie/mollie-api-php": "v3.13.2",
        "openai-php/client": "v0.20.1",
        "paytabscom/laravel_paytabs": "1.10.0",
        "razorpay/razorpay": "2.9.3",
        "spatie/laravel-medialibrary": "11.23.6",
        "spatie/laravel-permission": "8.3.0",
        "stripe/stripe-php": "v21.3.1",
        "tightenco/ziggy": "v2.6.4",
        "twilio/sdk": "8.12.0",
        "whichbrowser/parser": "v2.1.8",
        "yoomoney/yookassa-sdk-php": "3.15.1"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "v3.7.0",
        "fakerphp/faker": "v1.24.1",
        "friendsofphp/php-cs-fixer": "v3.95.24",
        "nunomaduro/collision": "v8.9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helper.php",
            "app/Helpers/AssetHelper.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "php-cs-fixer": "php-cs-fixer --config=.php-cs-fixer.dist.php",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"yarn run dev\" --names=server,queue,logs,vite"
        ],
        "dev:ssr": [
            "yarn run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
